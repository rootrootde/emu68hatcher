failat 21
; i2c.library polls Pi registers indefinitely under UAE.
Set HatcherUseI2C 0
IF EXISTS C:SetClockI2C
   C:Version brcm-emmc.device >NIL:
   IF NOT FAIL
      Set HatcherUseI2C 1
   ELSE
      C:Version brcm-sdhc.device >NIL:
      IF NOT FAIL
         Set HatcherUseI2C 1
      ENDIF
   ENDIF
ENDIF
IF $HatcherUseI2C EQ 1
   C:SetClockI2C >NIL: LOAD
   IF WARN
      C:SetClock >NIL: LOAD
   ENDIF
ELSE
   C:SetClock >NIL: LOAD
ENDIF
UnSet HatcherUseI2C
failat 10
